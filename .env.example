# ─────────────────────────────────────────────────────────────────────────────
# Kongila — environment variables
#
# This file is COMMITTED. It must never contain a real key. Placeholders only.
#
# Copy it to .env.local in each app you are running and fill in the real values
# from the Supabase dashboard:
#   apps/kongila-web/.env.local     (client + talent portal, port 3000)
#   apps/admin-panel/.env.local     (admin portal, port 3002)
#   apps/remotan-web/.env.local     (not needed for the Kongila launch)
#
# A copy at the repo root is also needed for the maintenance scripts, which
# load it through dotenv.
#
# .env and .env.local are gitignored. This file is not, which is why it carries
# placeholders. If you ever paste a real value here, treat that key as leaked
# and rotate it.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ─────────────────────────────────────────────────────────────────
#
# Known projects. Check the ref in the URL before running anything that writes.
#   staging     bsmwuofugczuhdbintgs    the only project today, throwaway data
#   production  not created yet         built from the repo, starts empty
#
# The git branch named staging and the Supabase project named staging are
# different things. Both are in play during the sprint.

# Project URL, e.g. https://yourproject.supabase.co
# Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / publishable key. This one reaches the browser by design, so it is not
# a secret. It is only safe because row level security is enforced on every
# table — if RLS is off, this key is full access to the database.
# Supabase dashboard → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key. THIS IS A REAL SECRET. It bypasses row level security
# completely. Server-side API routes and maintenance scripts only. Never
# prefix it with NEXT_PUBLIC_, never import it into a component, never paste
# it into chat, a ticket, an AI session, or this file.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Same value as NEXT_PUBLIC_SUPABASE_URL. Some server-side scripts read this
# name instead. Worth consolidating onto one name during the sprint.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co


# ── Application ──────────────────────────────────────────────────────────────

# Base URL of the client portal, used to build invite and callback links.
# Local: http://localhost:3000
# Production: https://app.kongila.io (confirm the real domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the administrator portal, used by operator setup links.
# Local: http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Secret used to sign team invitation links. THIS IS A REAL SECRET.
# At least 32 characters. Without it, invitations cannot be issued or
# accepted, which is deliberate: there is no unsigned fallback.
# Generate one with:  openssl rand -base64 48
# Changing it invalidates every invitation already sent.
INVITE_TOKEN_SECRET=YOUR_INVITE_TOKEN_SECRET


# ── Transactional email (Resend) ──────────────────────────────────────────────
#
# Add these to apps/kongila-web/.env.local and apps/admin-panel/.env.local,
# and to each app's Vercel project environment variables. Never use a
# NEXT_PUBLIC_ prefix. RESEND_FROM must use a sender on a domain verified in
# Resend; the API key must be created in Resend and kept server-side.
# EMAIL_LOGO_URL should point to a public logo image; otherwise the client
# portal logo path under NEXT_PUBLIC_SITE_URL is used.
# EMAIL_SUPPORT_EMAIL is shown in the branded email footer.
# After configuring the admin app, use the test-email button in Users & Roles.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Kongila <notifications@YOUR_VERIFIED_DOMAIN.com>"
OTP_HASH_SECRET=replace_with_a_random_64_character_secret
EMAIL_LOGO_URL=
EMAIL_SUPPORT_EMAIL=
EMAIL_REPLY_TO=
#
# The root .env copy can also carry these values if a root-level maintenance
# script needs to send email. Do not commit real credentials here.
#
# ── Not wired yet ────────────────────────────────────────────────────────────
# E-signature: provider API key, webhook secret
# Error monitoring: DSN or project key
#
# Remote Readiness speed test (public configuration; no secrets).
# Deploy a Kongila-controlled LibreSpeed frontend/backend over HTTPS first.
# The frontend URL must serve speedtest.js; the backend URL must expose
# LibreSpeed-compatible garbage.php and empty.php endpoints with CORS enabled
# for the Kongila web origin. Leave blank to keep the clearly labelled manual
# speed estimate available until the test server is deployed.
NEXT_PUBLIC_LIBRESPEED_URL=
NEXT_PUBLIC_LIBRESPEED_BACKEND_URL=
#
# Add each one to this file as it goes in, with a comment saying what it does
# and whether it is a secret — placeholder value only.
